# Supabase
# Copia este archivo a .env y rellena los valores desde tu proyecto en https://supabase.com
# IMPORTANTE: usa la "Publishable key" (anon key), NUNCA la "Secret key" ni la "service_role".

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key-anon